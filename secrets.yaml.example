# Copy this file to esphome/secrets.yaml (next to the firmware YAML, git-ignored) and fill in real values.

# ESPHome native API encryption key — generate with:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
stickc_env_quarto_api_key: "CHANGE_ME_32_BYTE_BASE64_KEY"

# OTA (over-the-air update) password — any strong string.
stickc_env_quarto_ota_password: "CHANGE_ME"

# Password for the device's wifi fallback access point (shown if it can't
# join your network).
stickc_env_quarto_ap_password: "CHANGE_ME"

# Your wifi network credentials.
wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"
